{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "lsp": false,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/dist-ssr/**",
      "**/.vite/**",
      "**/coverage/**",
      "backend/output/**",
      "backend/data/**",
      "backend/logs/**",
      ".opencode/**",
      "*.log",
      "crash-debug-*.log",
      "debug-crash.pid",
      "**/*.map",
      "**/*.tsbuildinfo",
      "**/package-lock.json"
    ]
  },
  "mcp": {
    "yt-dlp": {
      "type": "local",
      "command": ["npx", "-y", "@kevinwatt/yt-dlp-mcp"]
    }
  }
}
